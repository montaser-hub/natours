# Copy to `config.env` and adjust. Only DATABASE and JWT_SECRET are required
# to run locally; everything else is optional and degrades gracefully.

NODE_ENV=development
PORT=3000

# MongoDB — the docker-compose service listens on 27018.
# For Atlas: mongodb+srv://<user>:<PASSWORD>@cluster0.xxxxx.mongodb.net/natours
DATABASE=mongodb://127.0.0.1:27018/natours
DATABASE_PASSWORD=

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Email (optional). Without EMAIL_HOST, emails are printed to the console.
EMAIL_FROM=hello@natours.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASS=
# Production transport
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=

# Stripe (optional). Without STRIPE_SECRET_KEY the app runs in demo-booking
# mode: "Book tour" creates the booking directly, no payment step.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

mixin stars(rating)
    .reviews__rating(aria-label=`Rated ${rating} out of 5`)
        each star in [1, 2, 3, 4, 5]
            svg.reviews__star(class=`reviews__star--${rating >= star ? 'active' : 'inactive'}` aria-hidden='true')
                use(xlink:href='/img/icons.svg#icon-star-solid')

mixin reviewCard(review)
    .reviews__card
        .reviews__avatar
            img.reviews__avatar-img(src=`/img/users/${review.user.photo}`, alt=`${review.user.name}`)
            h6.reviews__user= review.user.name
        p.reviews__text= review.review
        +stars(review.rating)

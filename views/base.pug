doctype html
html(lang='en')
    head
        block head
            meta(charset='UTF-8')
            meta(name='viewport' content='width=device-width, initial-scale=1')
            meta(name='description' content='Natours — book exciting nature tours. A Node.js, Express, MongoDB and Pug app.')
            link(rel='stylesheet' href='/css/style.css')
            link(rel='icon' type='image/png' href='/img/favicon.png')
            link(rel='preconnect' href='https://fonts.googleapis.com')
            link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
            link(href='https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap' rel='stylesheet')
            title Natours | #{title}

    body(data-alert=alert ? alert : false)
        include _header
        block content
            h1 This is the placeholder heading
        include _footer

        block scripts
        script(src='/js/bundle.js' defer)

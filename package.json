{
  "name": "natours",
  "version": "2.0.0",
  "description": "Tour booking app — Node.js, Express, MongoDB and Pug. Built through Jonas Schmedtmann's Node.js bootcamp, then extended.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "build:js": "esbuild public/js/index.js --bundle --minify --sourcemap --target=es2019 --outfile=public/js/bundle.js",
    "watch:js": "esbuild public/js/index.js --bundle --sourcemap --target=es2019 --outfile=public/js/bundle.js --watch",
    "seed": "node dev-data/seed.js --import",
    "seed:delete": "node dev-data/seed.js --delete",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down"
  },
  "author": "Montaser Ismail",
  "license": "SEE LICENSE IN README.md",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pug": "^3.0.3",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.6.0",
    "validator": "^13.12.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^5.16.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.1.0",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.12.4",
    "nodemon": "^3.1.9",
    "prettier": "^1.17.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "sharp@0.33.5": true
  }
}
